to monitor_testagents

  ; Kör influencernas riktiga beteende så conflictActive hålls levande
  ask influencers [ hybrid_influencer ]

  ; Kör följarnas beteende med conflict-override
  ask followers [ monitor_follower ]

end

;*********************************************************************************************************************************************************
