; ********************************************************************************************************************************************************
;*** AGENTC.NLS (Admin / Plattformens Polisbil - "Stop & Frisk" Mode)                                                                     ****
;*********************************************************************************************************************************************************
; BESKRIVNING:
; - Admin fungerar som en polisbil som patrullerar mellan olika influencers (AgentA).
; - Polisen IGNORERAR influencers som redan är under Shadowban.
; - När Admin når en aktiv influencer "stoppas" den (rörelsen fryses) under en kontrollperiod.
; - Under kontrollen:
;     1. Om influencern bråkar (conflictActive) ges en rimlig boost om det är "bra drama".
;     2. Om bråket är för toxiskt (över banThreshold) utdelas en Shadowban och polisen åker direkt.
; - Shadowban: Influencern fryser på plats (moveSpeed 0), blockeras från nya följare (engagementRadius 0),
;   får en "BANNED" skylt, och förlorar följare ner till 50%. Straffet är förlängt för att följare ska hinna fly.
;*********************************************************************************************************************************************************

; LOCAL VARIABLES (ADMIN STATE)
agentCs-own [
  boostPower         ; Hur många följare som "boostas" in i flödet vid bra drama
  banThreshold       ; Gräns för shadowban (baserat på AgentA:s conflictIntensity)
  agentCSpeed        ; Hur snabbt polisbilen kör
  targetInfluencer   ; Influencern som polisen är på väg till just nu
  adminState         ; "patrol" (letar) eller "checking" (kontroll pågår)
  checkTimer         ; Nedräkning för hur länge kontrollen varar
]

; **********************************************************************************************************************************************************
; SETUP FUNCTIONS
to setup-agentCs
  create-agentCs 1 [
    set label ""
    set shape "car"     ; Om "car" inte finns i ditt NetLogo, ändra till "target"
    set color blue      ; Polisblå
    set size 3
    setxy random-xcor random-ycor
    
    ; Initiera variabler
    set boostPower 2    ; En rimlig boost (2 följare per tick)
    set banThreshold 75 ; Shadowban vid 75% intensitet
    set agentCSpeed 0.8
    set adminState "patrol"
    set targetInfluencer nobody
  ]
  
  ; Nollställ alla influencers inför start
  ask influencers [
    set is-shadowbanned false
    set is-stopped-by-admin false
    set label ""
    set moveSpeed 0.5        ; Säkerställ att de kan röra sig från start
    set engagementRadius 20  ; Säkerställ standardradien
  ]
end

; **********************************************************************************************************************************************************
; UPDATE information about the agent's environment
to updateEnvironmentInfo_agentCs
  ; Denna lämnas tom medvetet enligt mallen. All logik sker i reactive_agentCs.
end

; **********************************************************************************************************************************************************
; REACTIVE SUBSUMPTION HIERARCHY
to reactive_agentCs
  ; 1. Hantera polisens patrullering och stopp-kontroller
  manage-police-patrol
  
  ; 2. Hantera aktiva shadowbans (Skyltar, frysa och följarförlust)
  manage-shadowbans_agentC
end

; **********************************************************************************************************************************************************
; ADMIN LOGIK: PATRULL OCH KONTROLL
to manage-police-patrol
  ask agentCs [
    
    ; --- LÄGE 1: PATRULLERING (Letar efter nästa influencer) ---
    if adminState = "patrol" [
      if targetInfluencer = nobody [ 
        ; VÄLJ BARA INFLUENCERS SOM INTE ÄR BANNADE! (Polisen skippar spökprofiler)
        let valid-targets influencers with [not is-shadowbanned]
        ifelse any? valid-targets [
          set targetInfluencer one-of valid-targets
        ] [
          ; Om ingen giltig måltavla finns, rör sig polisen bara framåt
          fd agentCSpeed
        ]
      ]
      
      if targetInfluencer != nobody [
        face targetInfluencer
        fd agentCSpeed
        
        ; Om polisen når influencern -> PÅBÖRJA KONTROLL
        if distance targetInfluencer < 1.5 [
          set adminState "checking"
          set checkTimer 100 ; Kontrollen varar max i 100 ticks
          
          ask targetInfluencer [
            set is-stopped-by-admin true
            set label "POLICE CHECK"
          ]
        ]
      ]
    ]
    
    ; --- LÄGE 2: KONTROLL (Står stilla med influencern) ---
    if adminState = "checking" [
      set checkTimer checkTimer - 1
      
      ; TVINGA Influencern att stå helt stilla hos polisen
      let police-x xcor
      let police-y ycor
      if targetInfluencer != nobody [
        ask targetInfluencer [ setxy police-x police-y ]
        
        ; Om influencern har en konflikt på gång under kontrollen:
        if [conflictActive] of targetInfluencer = true [
          analyze-conflict-during-stop
        ]
      ]
      
      ; När tiden är ute (eller om polisen tvingade ner den till 0 efter en ban):
      if checkTimer <= 0 [
        if targetInfluencer != nobody [
          ask targetInfluencer [ 
            set is-stopped-by-admin false 
            ; Ta bara bort polis-skylten om de INTE blev bannade
            if not is-shadowbanned [ set label "" ]
          ]
        ]
        ; Släpp influencern och åk vidare direkt
        set adminState "patrol"
        set targetInfluencer nobody
      ]
    ]
    
    bounce-at-boundary_agentC
  ]
end

to analyze-conflict-during-stop
  ; Denna procedur körs av Admin-agenten under en kontroll
  let current-target targetInfluencer
  
  ifelse [conflictIntensity] of current-target > banThreshold [
    ; --- FALL A: FÖR TOXISKT -> SHADOWBAN ---
    ask current-target [
      if not is-shadowbanned [
        set is-shadowbanned true
        set shadowban-target int (followerCount / 2) ; Mål: tappa 50% av följarna
        set conflictActive false   ; Stoppa bråket direkt
        set reputation 0           ; Ryktet krossas
        
        ; NYA STRAFFET: Frys fast dem, sätt upp skylten och BLOCKERA
        set moveSpeed 0            ; De kan inte röra sig!
        set engagementRadius 0     ; Gör dem OSYNLIGA så de inte får nya följare
        set label "BANNED"         ; Skylten syns tydligt
      ]
    ]
    
    ; Polisen är klar med sitt jobb här, avbryt stoppet omedelbart och åk vidare!
    set checkTimer 0
    
  ] [
    ; --- FALL B: BRA DRAMA -> RIMLIG BOOST ---
    let potential-viewers agentBs with [following != current-target] in-radius 25
    if any? potential-viewers [
      ask n-of (min list boostPower count potential-viewers) potential-viewers [
        set following current-target
        set loyaltyTimer 0
      ]
    ]
  ]
end

to manage-shadowbans_agentC
  ; Hanterar straffet för alla influencers som är shadowbannade
  ask influencers with [is-shadowbanned = true] [
    
    ; För säkerhets skull, se till att de står stilla, är osynliga och har skylten
    set moveSpeed 0
    set engagementRadius 0
    set label "BANNED"
    
    ; FÖLJAR-STRAFF: Blödning av följare ner till 50%
    let my-followers agentBs with [following = myself]
    if followerCount > shadowban-target and any? my-followers [
      
      ; SAKTA NER STRAFFET: Tappar bara följare var 15:e tick så det drar ut på tiden
      if ticks mod 15 = 0 [
        ask one-of my-followers [
          set following nobody
          set color gray
          set state "state_wander"
          
          ; AKTIV SPRIDNING: Tvinga följaren att vända ryggen till och gå därifrån!
          rt 180 + random 40 - 20
        ]
      ]
    ]
    
    ; ÅTERSTÄLLNING: När målet är nått lyfts straffet
    if followerCount <= shadowban-target [
      set is-shadowbanned false
      set reputation 40        ; De får en chans att börja om
      set moveSpeed 0.5        ; KAN BÖRJA GÅ IGEN!
      set engagementRadius 20  ; SYNLIGA IGEN: Kan få nya följare!
      set label ""             ; TAR BORT SKYLTEN!
    ]
  ]
end

; **********************************************************************************************************************************************************
; HELP FUNCTIONS
to bounce-at-boundary_agentC
  if xcor >= max-pxcor or xcor <= min-pxcor [ set heading (- heading) ]
  if ycor >= max-pycor or ycor <= min-pycor [ set heading (180 - heading) ]
end