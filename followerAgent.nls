; LOCAL VARIABLES
followers-own [
    following         ; current favorite influencer 
    resistance        ; loyalty strength against being stolen
    state             ; current reactive state
    loyaltyTimer      ; how long they've been following the current influencer
    switchCooldown    ; cooldown timer to prevent rapid switching
    boredom           ; Internal timer for proactive behavior
    target-state      ; Temporarily holds the decision made by the layers
    global-scan-timer ; Timer for how often to check global trends
    excitement        ; Internal timer for gossip mechanic
    fmax              ; maximum members of friends
    friend            ; potential friend to add or follow
    friendList        ; agent set of other citizen agents that are considered as friends
    friends           ; list with numbers of agents (same as friendList, but as a sorted list)
    friendFound       ; Flag to indicate when friend has been found
    nearbyAgents      ; temporary variable to hold nearby agents for friend detection 
    vision            ; how far the follower can see to find friends
    favcontent        ; the type of content this follower prefers, represented as a number from 1 to 5   
]
;******************* end local variables *****************************************************************************************************************
;**********************************************************************************************************************************************************
; SETUP FUNCTIONS
to setup-followerAgent 
  create-followers  Number_AgentB  [
    setxy random-xcor random-ycor       ; Start at random positions
    set shape "person"
    set size 0.5                        ; Followers are smaller than influencers
    set following nobody                ; Start with no influencer
    set resistance base-resistance      ; Initial loyalty resistance (Global variable defined in globals.nls)
    set loyaltyTimer 0                  ; Timer for how long they've been following the current influencer
    set switchCooldown 0                ; Timer to prevent rapid switching between influencers  
    set state "state_wander"            ; Initial state
    set target-state "state_wander"     ; Initial target state
    set boredom random 50               ; Start with random boredom so they don't all leave at once
    set global-scan-timer random 200    
    set excitement random 100
    set favContent 1 + random 5         ; Randomly assign a preferred content type (1 to 5)
    set friendList turtle-set []        ; initialize empty agent set for friends
    set friends ""                      ; initialize empty list for friends (for easier debugging and visualization)
    set vision 7                        ; how far the follower can see to find friends               
    set fmax 100                        ; max antal vänner
    set friend nobody                   ; initialize friend variable  
    set incoming-queue []               
  ]
end 
;******************* end setup functions *****************************************************************************************************************

;**********************************************************************************************************************************************************
; MAIN BEHAVIORAL FUNCTIONS
to hybrid_followers
  evaluate-reactive-layer               ; evaluate the reactive layer to determine the target state based on current conditions
  evaluate-proactive-layer              ; evaluate the proactive layer to potentially override the target state based on boredom, global trends, or gossip
  execute-hybrid-state                  ; execute the behavior corresponding to the final target state
end
;******************** end main behavioral functions *******************************************************************************************************
;**********************************************************************************************************************************************************
; UPDATE ENVIRONMENT INFORMATION (required by main model loop)
to updateEnvironmentInfo_followers
  ; Placeholder for compatibility with main loop
end
;***************************end environment update ********************************************************************************************************
;**********************************************************************************************************************************************************
; FINITE STATE MACHINE
; States: Wander, Follow, and Defend Loyalty
; Wander: random movement
; Follow: move toward influencer
; Defend Loyalty: react to influencer conflict

to state_wander
  update-follower-color                             ; update color to reflect lack of influencer
  rt random 50 - random 50                          ; random turn to create more natural wandering
  fd speed                                          ; move forward at normal speed
  bounce-at-boundary                                ; bounce off walls to stay within the environment
  addFriends                                        ; look for nearby agents to add to friend list                
end

to state_follow
  set loyaltyTimer loyaltyTimer + 1                 ; increment loyalty timer to track how long we've been following the current influencer
  update-resistance                                 ; update resistance based on the influencer's reputation
  update-follower-color                             ; update color to match the influencer's color          

  ; periodically reevaluate influencer choice after being attached for a while 
  if ticks mod 20 = 0 and loyaltyTimer > 15 [       
  reevaluate-influencer-choice
  addFriends
  ]

  ; Move toward the influencer if we have one
  if following != nobody [
    face following
    fd speed
    bounce-at-boundary
  ]
end

to state_defend-loyalty
  set loyaltyTimer loyaltyTimer + 1
  update-resistance
  update-follower-color
  let attacker get-attacker-for following
  if attacker != nobody and following != nobody [
    if compute-attack-force attacker > compute-hold-force following [
      set following attacker
      set loyaltyTimer 0
      set switchCooldown 20
    ]
  ]
end
;***************************end finite state machine ******************************************************************************************************
;**********************************************************************************************************************************************************
; LAYER 1: REACTIVE DECISION-MAKING
to evaluate-reactive-layer
  set target-state "state_wander"
  if switchCooldown > 0 [ set switchCooldown switchCooldown - 1 ]

  ; drop a distant influencer if still newly attached
  if following != nobody and distance following > ([engagementRadius] of following * 1.75) [
    if loyaltyTimer < 15 and random-float 1 < 0.08 [
      set following nobody  set loyaltyTimer 0  set switchCooldown 10
    ]
  ]

  if following = nobody [ try-adopt-influencer ]

  if following != nobody [
    set target-state "state_follow"
    if [conflictActive] of following [ set target-state "state_defend-loyalty" ]
  ]
end

; LAYER 2: PROACTIVE DECISION-MAKING
to evaluate-proactive-layer
  ; ---------------------------------------------------------
  ; 1. BOREDOM MECHANIC 
  ; ---------------------------------------------------------
  set boredom boredom + 1
  if target-state = "state_follow" [
    if boredom > 150 [
      set following nobody       
      set target-state "state_wander" 
      set switchCooldown 20      
      set boredom 0              
    ]
  ]
  
  if target-state = "state_defend-loyalty" [
    set boredom 0
  ]

  ; ---------------------------------------------------------
  ; 2. GLOBAL TREND SCOUTING
  ; ---------------------------------------------------------
  set global-scan-timer global-scan-timer + 1
  
  ; Only check global trends if we are peacefully following someone
  if target-state = "state_follow" and global-scan-timer > 200 [
    set global-scan-timer 0 ; Reset the timer
    ; Look at the absolute biggest influencer on the whole map
    let global-star max-one-of influencers [reputation]
    if global-star != nobody and global-star != following [
      ; Proactive decision: If the global star's reputation is 50% higher than my current one...
      if [reputation] of global-star > ([reputation] of following * 1.5) [
        set following global-star  ; Proactively switch targets!
        set switchCooldown 30
        set boredom 0
        set excitement 0
      ]
    ]
  ]

  ; ---------------------------------------------------------
  ; 3. GOSSIP MECHANIC
  ; ---------------------------------------------------------
  ; Agents get excited over time while following
  if target-state = "state_follow" [
    set excitement excitement + 1
    if excitement > 100 [
      ; Look for a neutral nearby follower, not an influencer
      let my-influencer following
      let potential-convert one-of other followers in-radius 2 with [following = nobody]
      if potential-convert != nobody and my-influencer != nobody [
        ask potential-convert [
          set following my-influencer
          set state "state_follow"
          set target-state "state_follow"
          set loyaltyTimer 0
          set switchCooldown 20
        ]
        set excitement 0
      ]
    ]
   ]
end

to execute-hybrid-state
  set state target-state
  if state = "state_wander"[ 
    state_wander 
    followfriend
    sendmsg
    readContent
  ]

  if state = "state_follow"[ 
    state_follow
    sendmsg
    readContent
  ]

  if state = "state_defend-loyalty" [ 
    state_defend-loyalty  
  ]
end

;*****************************************end Layers ******************************************************************************************************
;**********************************************************************************************************************************************************
; INFLUENCER SELECTION
to try-adopt-influencer
  let candidates influencers with [distance myself <= engagementRadius]
  if any? candidates [
    set following max-one-of candidates [reputation - distance myself]
    set loyaltyTimer 0  set switchCooldown 15
    update-resistance  update-follower-color
  ]
end

to reevaluate-influencer-choice
  if following = nobody or switchCooldown > 0 [ stop ]
  let candidates influencers with [distance myself <= engagementRadius]
  if not any? candidates [ stop ]

  let best max-one-of candidates [reputation - distance myself]
  if best = following [ stop ]

  let current-score ([reputation] of following) - distance following
  let best-score    ([reputation] of best)      - distance best
  ; hysteresis: only switch when the alternative is clearly better
  let threshold 6 + (loyaltyTimer * 0.12) + (resistance * 0.05)

  if best-score > current-score + threshold and random-float 1 < 0.35 [
    set following best  set loyaltyTimer 0  set switchCooldown 30
  ]
end

to addFriends
  if (count friendList >= fmax) [ stop ]
  ; adds agents nearby to the friendList
  ; OBS: does not count how many that end up in the list!
  set nearbyAgents other followers in-radius vision
  if any? nearbyAgents [
    ;print (word "agent " self " in any? nearbys" )
    set friend min-one-of nearbyAgents [distance myself]; identify the agent that is nearest
    ; make sure friend is not the agent itself
    if not (friend = self) [; only bother if it is not myself
                            ; if the list of friends is empty, add the agent
      ifelse (not any? turtle-set friendList) [ set friendList turtle-set friend ]  ;
      ;ifelse (empty? friendList) [set friendList friend]
      [
            ;add the friend to the friendList
            ;set friendList lput friend friendList
            set friendList (turtle-set friend friendList)
            set friends sort friendList
        ;print (word "agent " self " in added to friendList" )
      ]
    ]  
  ] 
end


;This function is all about following another follower agent that is in freindlist if there is any
; runs only in wander state to not get in conflict with the follwoing behavier for the influencer
to followfriend
  ; Follows the nearest friend from friendList
  ; Check that friendList is not empty
  if not any? turtle-set friendList [ stop ]

  ; Pick the nearest friend from the friendList
  let target min-one-of turtle-set friendList [distance myself]
  if target = nobody [ stop ]
  ; Move toward target only if not on the same spot
  if ([list xcor ycor] of self) != ([list xcor ycor] of target) [
    set heading towards target
    fd 1
  ]
  
  ; Check if we've reached the friend
  set nearbyAgents other turtles in-radius vision
  if any? nearbyAgents [
    if member? target nearbyAgents [
      set friendFound true
      ;TO DO 
      ;what happens when friend is found spread content 
      
      if [following] of target != nobody [
        set following [following] of target  ; kopiera vännens influencer
        set loyaltyTimer 0
        set switchCooldown 15
      ]
    ]
  ]
 ; if Debug [ print (word "Follower " self " försöker nå vän " target) ]
end

;--------------------------------------------------------------------------------------------------------------
to sendmsg
  ;here we send 
  ;we first check if we have any friends in the freind list before we begin
  ;after the check for friends we create the msg and sends only to the follower agent simple and clean work.
  ;last part is teh print we can remove beacuse i used it to debug.
  if not any? turtle-set friendList [ stop ]
  if ticks mod 100 != 0 [ stop ]
  if following = nobody [ stop ]  
  ask turtle-set friendList with [breed = followers] [ 
    let msg create-message "inform" 
    set msg add-receiver who msg
    ; skickar influencer + favcontent
    set msg add-content (word "influencer:" [who] of myself " fav:" [favContent] of myself) msg  
    send msg
  ]
end

to readContent
  if empty? incoming-queue [ stop ]
  while [not empty? incoming-queue] [
    let msg first incoming-queue

    set incoming-queue but-first incoming-queue
    let sender-id get-sender msg
    let content get-content msg
    let sender-agent turtle (read-from-string sender-id)

    ; influencer content
    if get-performative msg = "content-post" [
      if sender-agent != nobody [
        if [breed] of sender-agent = influencers [
          react-to-content content sender-agent
        ]
      ]
    ]
  
if get-performative msg = "inform" [
  if sender-agent != nobody [
    ;print (word "Sender exists: " [who] of sender-agent)
    if [breed] of sender-agent = followers [

      ; fall 1
      ; sender är min vän OCH vi gillar samma content
      if member? sender-agent friendList and
         [favContent] of sender-agent = favContent [
        ; följ samma influencer som vännen
        set following [following] of sender-agent
        set loyaltyTimer 0
        set switchCooldown 15
        set excitement excitement + 20
        print (word "Excitement is now " excitement)
      ]

      ; fall 2
      ; sender är min vän MEN vi gillar olika content
      if member? sender-agent friendList and
         [favContent] of sender-agent != favContent [
          ; get sender's influencer
          let sender-influencer [following] of sender-agent
          ;increase boredom if sender's influencer is different from mine
          if sender-influencer != following [
            set boredom boredom + 15
          ]
        ]
      ]
    ]
  ]
]
end

; This function defines how followers react when they receive content from an influencer they follow.
; it simualte sharing content with friends and how it can influence their preferences and boredom levels.
to react-to-content [content-type sender-agent]
  if (read-from-string content-type) = favContent [
    if sender-agent = following [
      ask turtle-set friendList with [breed = followers] [
        let msg create-message "inform"
        set msg add-receiver who msg
        set msg add-content (word "influencer:" [who] of myself " fav:" [favContent] of myself) msg
        send msg
      ]
    ]
  ]

  if (read-from-string content-type) != favContent [
    if sender-agent != following [
      set boredom boredom + 20
    ]
  ]
end

;***************************end influencer selection ******************************************************************************************************
;**********************************************************************************************************************************************************
; CONFLICT / STEALING SUPPORT
to-report get-attacker-for [defender]
  let attackers influencers with [self != defender and conflictActive]                  ; find all active attackers that are not the defender itself
  if any? attackers [                                                                   ; if there are any, pick the one with the highest combined score of reputation, conflict intensity, and proximity
    report max-one-of attackers [reputation + conflictIntensity - distance myself]      
  ]
  report nobody                                                                         ; if there are none, report nobody
end

to-report compute-attack-force [attacker] 
  let attacker-reputation [reputation] of attacker                                      ; the base appeal of the attacker based on their reputation
  let attacker-conflict [conflictIntensity] of attacker                                 ; the current intensity of the attack, which can make it more attractive to switch
  report attacker-reputation + 0.35 * attacker-conflict - 0.4 * distance attacker       ; the overall force of the attack is a combination of the attacker's reputation, and how close the attacker
end

to-report compute-hold-force [defender]
  report [reputation] of defender + resistance + 0.05 * loyaltyTimer
end
;***************************end conflict support **********************************************************************************************************
;**********************************************************************************************************************************************************
; HELP FUNCTIONS
to bounce-at-boundary
  if xcor >= max-pxcor [ set xcor max-pxcor  set heading (- heading) ]
  if xcor <= min-pxcor [ set xcor min-pxcor  set heading (- heading) ]
  if ycor >= max-pycor [ set ycor max-pycor  set heading (180 - heading) ]
  if ycor <= min-pycor [ set ycor min-pycor  set heading (180 - heading) ]
end

to update-follower-color
  ifelse following = nobody [ set color gray ] [ set color [color] of following ]
end

to update-resistance
  ifelse following != nobody [
    set resistance min (list max-resistance (base-resistance + resistance-factor * [reputation] of following))
  ] [
    set resistance base-resistance
  ]
end
;***************************end help functions ************************************************************************************************************
;**********************************************************************************************************************************************************





