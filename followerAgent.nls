;*********************************************************************************************************************************************************
; LOCAL VARIABLES

followers-own [
    following  ; current favorite influencer 
    resistance ; loyalty strength against being stolen
    state      ; current reactive state
    loyaltyTimer
    switchCooldown
  
  
  ;new code for debug in case ---------------------------------------------------------------------------
  fmax;-----------maximum members of friends
  friend;---------potential friend to add or follow
  friendList;-----agent set of other citizen agents that are considered as friends
  friends;--------list with numbers of agents (same as friendList, but as a sorted list)
  
  
  followFlag;-----Flag to indicate the situation of following a friend
  collectFriends;-Flag to indicate the situation of adding agents to friendList
  friendFound;--- Flag to indicate when friend has been found
  
  nearbyAgents
  vision
  
  inbox        ; list of messages received from friends
  lastMessage  ; last message this agent sent
  
]


;******************* end local variables *****************************************************************************************************************
;**********************************************************************************************************************************************************
; SETUP FUNCTIONS
to setup-followerAgent

  create-followers Number_AgentB  [
    setxy random-xcor random-ycor
    set shape "person"
    set size 0.5
    set following nobody
    set resistance base-resistance
    set state "state_wander"
    set loyaltyTimer 0
    set switchCooldown 0
    set incoming-queue []
    update-follower-color
    
    
 
    
    ;new code for debug in case ----------------------------------------------------------------------
    set friend []
    set friendList turtle-set []
    set friends ""
    set vision 7 ;
    set fmax 1  ; max antal vänner
    set collectFriends false
    
    set inbox []
    
   
     
  ]
  
end ;setup-agentBs

;**********************************************************************************************************************************************************
; UPDATE ENVIRONMENT INFORMATION (required by main model loop)

to updateEnvironmentInfo_followers
  ; Placeholder for compatibility with main loop
end

;***************************end environment update ********************************************************************************************************
;**********************************************************************************************************************************************************
; REACTIVE DECISION HIERARCHY

to reactive_followers
  
  update-state_follower
  if state = "state_wander" [
    state_wander
    ;readContent
    sendmsg
    readmsg
    
    
         
    stop
  ]

  if state = "state_follow" [
    state_follow
    ;readContent
    sendmsg
    readmsg
    
        
    stop
  ]

  if state = "state_defend-loyalty" [
    state_defend-loyalty
    stop
  ]
  
 

  
 
end

;***************************end reactive hierarchy ********************************************************************************************************

;**********************************************************************************************************************************************************
; STATE UPDATE
to update-state_follower
  if switchCooldown > 0 [
    set switchCooldown switchCooldown - 1
  ]
  
  if following = nobody [
    try-adopt-influencer
    if following = nobody [
      set state "state_wander"
      stop
    ]
  ]

  if [conflictActive] of following [
    set state "state_defend-loyalty"
    stop
  ]

  set state "state_follow"
  
end


;***************************end state update **************************************************************************************************************
;**********************************************************************************************************************************************************
; FINITE STATE MACHINE

to state_wander
  update-follower-color
  rt random 50 - random 50
  fd speed
  bounce-at-boundary
  try-adopt-influencer
  addFriends
end

to state_follow
  set loyaltyTimer loyaltyTimer + 1
  update-resistance
  update-follower-color

  ; re-evaluate more often so influencer counts can change
  if ticks mod 20 = 0 and loyaltyTimer > 15 [
  reevaluate-influencer-choice
  ]

  ; small exploration only for weakly committed followers
  if loyaltyTimer < 20 and switchCooldown = 0 and random-float 1 < 0.002 [
    let current-following following
    let alt one-of influencers with [self != current-following]
    if alt != nobody [
      set following alt
      set loyaltyTimer 0
      set switchCooldown 25
  ]
]

  ; if follower drifts too far from current influencer, it may detach
  if following != nobody [
    if distance following > ([engagementRadius] of following * 1.75) [
      if loyaltyTimer < 15 and random-float 1 < 0.08 [
        set following nobody
        set loyaltyTimer 0
        set switchCooldown 10
        set state "state_wander"
        stop
    ]
  ]
]

  if following != nobody [
    face following
    fd speed
    bounce-at-boundary
  ]
end

to state_defend-loyalty
  set loyaltyTimer loyaltyTimer + 1
  update-resistance
  update-follower-color

  let attacker get-attacker-for following

  if attacker != nobody and following != nobody [
    let attack-force compute-attack-force attacker
    let hold-force compute-hold-force following

    if attack-force > hold-force [
      set following attacker
      set loyaltyTimer 0
      set switchCooldown 20
    ]
  ]

  if following = nobody [
    set state "state_wander"
  ]
  if following != nobody [
    set state "state_follow"
  ]
end



;***************************end finite state machine ******************************************************************************************************
;**********************************************************************************************************************************************************
; INFLUENCER SELECTION
to try-adopt-influencer
  let candidates influencers with [distance myself <= engagementRadius]

  if any? candidates [
    ; pick the strongest nearby option when unattached
    let best-choice max-one-of candidates [reputation - distance myself]
    set following best-choice
    set loyaltyTimer 0
    set switchCooldown 15
    update-resistance
    update-follower-color
  ]
end

to reevaluate-influencer-choice
  if following = nobody [ stop ]
  if switchCooldown > 0 [ stop ]

  let candidates influencers with [distance myself <= engagementRadius]
  if not any? candidates [ stop ]

  let best-choice max-one-of candidates [reputation - distance myself]
  if best-choice = following [ stop ]

  let current-score ([reputation] of following) - distance following
  let best-score ([reputation] of best-choice) - distance best-choice

  ; stronger hysteresis: followers only switch when the alternative is clearly better
  let switching-threshold 6 + (loyaltyTimer * 0.12) + (resistance * 0.05)

  if best-score > current-score + switching-threshold [
    if random-float 1 < 0.35 [
      set following best-choice
      set loyaltyTimer 0
      set switchCooldown 30
    ]
  ]
end



;new code  ---------------------------------------------------------------------------------------------------------



to addFriends
  
   if (count friendList >= fmax) [ stop ]
  
  
  ; adds agents nearby to the friendList
  ; OBS: does not count how many that end up in the list!
  set nearbyAgents other followers in-radius vision
  if any? nearbyAgents [
    ;print (word "agent " self " in any? nearbys" )
    set friend min-one-of nearbyAgents [distance myself]; identify the agent that is nearest
    ; make sure friend is not the agent itself
    if not (friend = self) [; only bother if it is not myself
                            ; if the list of friends is empty, add the agent
      ifelse (not any? turtle-set friendList) [ set friendList turtle-set friend ]  ;
      ;ifelse (empty? friendList) [set friendList friend]
      [
            ;add the friend to the friendList
            ;set friendList lput friend friendList
            set friendList (turtle-set friend friendList)
            set friends sort friendList
        ;print (word "agent " self " in added to friendList" )
        
       
      ]
          
    ]  
  ] 
end



to sendmsg
  ;here we send 
  ;we first check if we have any friends in the freind list before we begin
  ;after the check for friends we create the msg and sends only to the follower agent simple and clean work.
  ;last part is teh print we can remove beacuse i used it to debug.
  
  if not any? turtle-set friendList [ stop ]
  if ticks mod 100 != 0 [ stop ]
  
  let me self
  let msgContent "Hej! ska vi följa Nicki Minaj"  
  
  ask turtle-set friendList with [breed = followers] [ 
    let msg create-message "" 
    
    set msg add-receiver [who] of myself msg
    set msg add-content msgContent msg  
    send msg
    
    
    ; print (word "Follower " me " skickade: " msgContent)
  ]
end



to readmsg
  let msg get-message
  if msg = "no_message" [ stop ]
  
  ;here is the important part 
  ;we get the msg---read the massage--- and reaply to the massage 
  
  let performative get-performative msg
  let sender get-sender msg
  let content get-content msg  
  
  if performative = "" [
    
   ;simple print to show the communcaation in the terminal
    ;print (word "Follower " self " fick meddelande från Follower " sender)
    ;print (word "Innehåll: " content)
    
    ;;answer
    let replyContent "Ja"  
    let reply create-reply "hej" msg
    set reply add-content replyContent reply
    send reply
    
   
    ;print (word "Follower " self " svarade: " replyContent)
  ]
end



;This is not finished yet i need more time to figur out how to react to content 
; TODO 

to readContent
  
  if empty? incoming-queue [ stop ]
  
  let msg last incoming-queue
  set incoming-queue but-last incoming-queue
  
  let sender get-sender msg
  let content get-content msg
  
  ; om avsändaren är din influencer, berätta för vänner
  if sender = following [
    if any? turtle-set friendList [
      ask turtle-set friendList [
        ; byt till samma influencer om du inte redan följer den
        if following != sender [
          set following sender
          set loyaltyTimer 0
          set switchCooldown 20
          if Debug [ print (word self " bytte till " sender " tack vare en vän") ]
        ]
      ]
    ]
  ]
end



;***************************end influencer selection ******************************************************************************************************
;**********************************************************************************************************************************************************
; CONFLICT / STEALING SUPPORT
to-report get-attacker-for [defender-agent]
  let attackers influencers with [self != defender-agent and conflictActive]

  if any? attackers [
    report max-one-of attackers [reputation + conflictIntensity - distance myself]
  ]

  report nobody
end

to-report compute-attack-force [attacker-agent]
  let rep [reputation] of attacker-agent
  let intensity [conflictIntensity] of attacker-agent
  let dist distance attacker-agent

  report rep + (0.35 * intensity) - (0.4 * dist)
end

to-report compute-hold-force [defender-agent]
  let rep [reputation] of defender-agent

  ; weaker hold than before so stealing can actually happen
  report rep + resistance + (loyaltyTimer * 0.05)
end




;***************************end conflict support **********************************************************************************************************
;**********************************************************************************************************************************************************
; HELP FUNCTIONS
to bounce-at-boundary
  if xcor >= max-pxcor [
    set xcor max-pxcor
    set heading (- heading)
  ]
  if xcor <= min-pxcor [
    set xcor min-pxcor
    set heading (- heading)
  ]
  if ycor >= max-pycor [
    set ycor max-pycor
    set heading (180 - heading)
  ]
  if ycor <= min-pycor [
    set ycor min-pycor
    set heading (180 - heading)
  ]
end

to update-follower-color
  ifelse following = nobody [
    set color gray
  ] [
    set color [color] of following
  ]
end

to update-resistance
  ifelse following != nobody [
    set resistance min (list max-resistance
      (base-resistance + resistance-factor * [reputation] of following))
  ] [
    set resistance base-resistance
  ]
end

;***************************end help functions ************************************************************************************************************
